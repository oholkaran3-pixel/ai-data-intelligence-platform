# Core Environment Settings
PROJECT_NAME="AI Data Intelligence Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="replace-with-a-secure-random-secret-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default for local development, switch to PostgreSQL for production)
DATABASE_URL="sqlite:///./storage/ai_data_intelligence.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/ai_data_intelligence"

# File Storage
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_MB=250

# LLM Providers (Optional - Non-AI data processing works independently)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Microsoft Power BI Integration (Optional - Direct Excel/CSV export works independently)
POWERBI_CLIENT_ID=""
POWERBI_CLIENT_SECRET=""
POWERBI_TENANT_ID=""
